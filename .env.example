# Gizli bilgiler config.yaml'a değil buraya yazılır. install.sh tarafından
# .env olarak kopyalanıp gerçek değerlerle doldurulur (Faz 7). .env Git'e
# eklenmez.

# Oturum/JWT imzalama anahtarı - install.sh tarafından rastgele üretilir.
JETSON_CAMERA_SECRET_KEY=

# İlk kurulumda oluşturulan varsayılan yönetici kullanıcı adı.
JETSON_CAMERA_ADMIN_USERNAME=admin

# Argon2 ile hash'lenmiş varsayılan yönetici parolası (düz metin DEĞİL).
# İlk girişte değiştirilmesi zorunlu tutulacaktır (Faz 5).
JETSON_CAMERA_ADMIN_PASSWORD_HASH=
